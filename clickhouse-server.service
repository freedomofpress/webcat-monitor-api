[Unit]
Description=ClickHouse Server
After=network.target srv-index.mount srv-archive.mount

[Service]
User=clickhouse
Group=clickhouse
ExecStart=/usr/local/bin/clickhouse server --config-file=/etc/clickhouse-server/config.xml --pid-file=/run/clickhouse-server/clickhouse-server.pid
RuntimeDirectory=clickhouse-server
Restart=always
RestartSec=5
LimitNOFILE=500000

[Install]
WantedBy=multi-user.target
